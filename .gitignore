# ==============================================================================
# Quarto Outputs & Temporary Artifacts
# ==============================================================================
/.quarto/           # Internal Quarto cache, project state, and metadata
/_site/             # The compiled static website (handled entirely by GitHub Actions)
/.luarc.json        # Local Lua configuration generated during rendering

# ==============================================================================
# Data Science & Language Specific Junk
# ==============================================================================
# Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
env/
venv/

# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# ==============================================================================
# Operating System System Files
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Ehthumbs.db
Desktop.ini